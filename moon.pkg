} for "test"

import {
  "moonbitlang/async",
  "moonbitlang/core/env",
} for "wbtest"

options(
  targets: {
    "async_http_transport.mbt": [ "native", "wasm", "js" ],
    "chroma_wbtest.mbt": [ "native", "wasm", "js" ],
  },
)
